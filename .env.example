# --- Postgres ---
POSTGRES_USER=psi_user
POSTGRES_PASSWORD=psi_password
POSTGRES_DB=psi_db
POSTGRES_PORT=5432

# Backend connects to Postgres using the service name "db" (Docker Compose network DNS)
DATABASE_URL=postgresql+psycopg://psi_user:psi_password@db:5432/psi_db

# --- Backend ---
BACKEND_PORT=8000
# Comma-separated list of origins allowed to call the API from a browser
BACKEND_CORS_ORIGINS=http://localhost:5173

# --- Frontend ---
# Base URL the browser uses to reach the backend (browser-side, not container-to-container)
VITE_API_BASE_URL=http://localhost:8000

# --- Backend: JWT auth (Phase 2) ---
# Uncomment and set a real secret before ENVIRONMENT=production — the app
# refuses to start in production with the checked-in development default.
# JWT_SECRET_KEY=
# ENVIRONMENT=development

# --- Backend: document ingestion limits (Phase 3) ---
# All optional — sensible defaults live in app/core/config.py. Uncomment only
# to override for local experimentation.
# MAX_DOCUMENT_SIZE_BYTES=10485760
# MAX_DOCUMENT_PAGES=20
# MAX_DOCUMENTS_PER_ORGANIZATION=10
# DOCUMENT_STORAGE_ROOT is intentionally NOT listed here — it's pinned to the
# container path tied to the document_storage volume in docker-compose.yml
# and should not be overridden per-host.

# --- Backend: embeddings (Phase 4) ---
# Optional. Without a key the app still boots and uploads still succeed — chunks
# are created but left un-embedded, and POST /api/retrieval/search returns 503
# until a key is configured. Never commit a real key.
# EMBEDDING_PROVIDER=openai
# OPENAI_API_KEY=
# EMBEDDING_MODEL=text-embedding-3-small
# To use Gemini instead, set EMBEDDING_PROVIDER=gemini and GEMINI_API_KEY below.
# GEMINI_EMBEDDING_MODEL=gemini-embedding-2
# (The embedding dimension, 1536, is a fixed constant tied to the pgvector column —
#  it is intentionally not configurable here.)

# --- Backend: grounded answer generation (Phase 6) ---
# Reuses OPENAI_API_KEY above. Without it, /api/ask returns a safe 503.
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o-mini
# ANSWER_MIN_SIMILARITY=0.25
# Set LLM_PROVIDER=gemini to use Gemini for both decision planning and answers.
# GEMINI_LLM_MODEL=gemini-3.8-flash

# GEMINI_API_KEY is shared by the Gemini embedding and LLM providers.
# GEMINI_API_KEY=

# --- Backend: structured decisions (Phase 7) ---
# Laya uses its local System 1 model. CPU is supported; model weights are
# fetched by Laya on its first structured decision request.
# LAYA_DEVICE=cpu
